<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/timer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/timer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textColor="#666666" />

    <!-- FrameLayout с ежом и каштанами поверх прогресс-бара -->
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chestnut_25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌰"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chestnut_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌰"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chestnut_75"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌰"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chestnut_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌰"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hedgehog_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦔"
            android:textSize="16sp"
            android:scaleX="-1"
            android:layout_gravity="start" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="0" />
    </FrameLayout>

    <TextView
        android:id="@+id/progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#999999" />

</LinearLayout>
